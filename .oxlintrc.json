{
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "dist/**",
    "dist-electron/**",
    "dist-native/**",
    "dist-server/**",
    "electron/vendor/**",
    "startupbot-site/web/hash-4.12.0/sha256.js",
    "startupbot-site/web/runtime-2.3.7/wllama.js",
    "release/**",
    "third_party/**",
    "electron/resources/**"
  ],
  "overrides": [
    {
      "files": ["packages/phone-protocol/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{ "group": ["node:*"], "message": "The phone imports this package: no Node modules." }]
        }],
        "no-restricted-globals": ["error",
          { "name": "window", "message": "The phone imports this package: no DOM." },
          { "name": "document", "message": "The phone imports this package: no DOM." }
        ]
      }
    }
  ]
}
