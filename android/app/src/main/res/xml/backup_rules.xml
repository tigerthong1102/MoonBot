<!-- Device tokens and key material must not migrate; permission/onboarding consent is device-local. -->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="companion_device_token.xml" />
    <exclude
        domain="sharedpref"
        path="__androidx_security_crypto_encrypted_prefs__.xml" />
    <exclude
        domain="sharedpref"
        path="openmaus.permissions.xml" />
    <exclude
        domain="sharedpref"
        path="openmaus.onboarding.xml" />
</full-backup-content>
