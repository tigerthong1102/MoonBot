{
  "name": "startupbot-inbox",
  "main": "../src/personal-inbox-worker.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "SIGNALS", "class_name": "InboxSignals" }] },
  "migrations": [{ "tag": "inbox-signals-v1", "new_sqlite_classes": ["InboxSignals"] }],
  "build": { "command": "pnpm --filter @openmausbot/control-plane inbox:assets" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "startupbot-inbox", "migrations_dir": "./migrations" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["15 3 * * *"] }
}
