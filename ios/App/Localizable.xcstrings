        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn giọng nói thuộc về tác vụ này. Đường dẫn mặc định trong vùng làm việc dùng giọng nói đã chọn chung trên máy tính."
          }
        }
      }
    },
    "Thinking…": {
