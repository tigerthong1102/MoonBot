    "Alerts arrive while StartupBot is open or was recently in the background. Closed-app delivery is not available yet.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas chegam enquanto o StartupBot está aberto ou esteve em segundo plano há pouco. A entrega com o app fechado ainda não está disponível."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo đến trong khi StartupBot mở hoặc gần đây ở nền Phân phối ứng dụng đóng chưa có sẵn."
          }
        }
      }
    },
    "All quiet": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
