            "state": "translated",
            "value": "Không thể mở liên kết này qua kết nối an toàn."
          }
        }
      }
    },
    "This notification has no saved computer. Open the conversation from your computer list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This notification has no saved computer. Open the conversation from your computer list."
          }
        },
