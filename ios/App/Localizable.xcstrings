        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thủ tục này sử dụng lịch được thêm bởi StartupBot mới hơn. Hãy chọn Một lần, Ngày đã chọn hoặc Mỗi X phút trước khi lưu."
          }
