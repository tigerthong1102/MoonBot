    "Add the shared ElevenLabs key in this agent's profile on the computer. The key is never returned to iOS.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a chave compartilhada do ElevenLabs no perfil deste agente no computador. A chave nunca é devolvida ao iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm khoá ElevenLabs đã chia sẻ vào hồ sơ của trợ lý này trên máy tính. Khóa này không bao giờ được trả về iOS."
          }
        }
      }
    },
    "Add to section": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar à seção"
