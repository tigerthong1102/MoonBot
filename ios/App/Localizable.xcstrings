          }
        }
      }
    },
    "This restores the four chips the app came with and discards your own.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto restaura os quatro chips originais do app e descarta os seus."
